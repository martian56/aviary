// End-to-end tests against an in-process std/http server posing as an
// OpenAI-compatible endpoint via the custom provider. These exercise the
// full path: routing, transport with timeout and retries, SSE parsing, and
// reply assembly, all without leaving the process. Each test starts its own
// server on its own port; deltas are recorded through a module global since
// every test runs in a fresh process.

import std.string
from std.http import Server, Request, Response
from std.time import sleep_millis
from std.test import assert_eq_int, assert_eq_str, assert_true
from "./request" import ChatRequest, CancelToken
from "./lib" import complete, complete_stream

let sink: list[str] = []
var hits = 0
let cancel_tok: CancelToken = CancelToken.new()

fun record(t: str) {
    sink.push(t)
}

// Records the delta, then cancels: the stream must stop before the next one.
fun record_and_cancel(t: str) {
    sink.push(t)
    cancel_tok.cancel()
}

fun chat_json(req: Request) -> Response {
    return Response.json_raw(
        "{\"model\":\"local-model\",\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"pong\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":3,\"completion_tokens\":1,\"total_tokens\":4}}",
    )
}

fun chat_sse(req: Request) -> Response {
    let doc = "data: {\"model\":\"local-model\",\"choices\":[{\"delta\":{\"content\":\"Hel\"}}]}\n\ndata: {\"choices\":[{\"delta\":{\"content\":\"lo\"}}]}\n\ndata: {\"choices\":[{\"delta\":{},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"
    return Response.text(doc)
}

fun chat_flaky(req: Request) -> Response {
    hits = hits + 1
    if hits == 1 {
        return Response.with_body(503, "warming up")
    }
    return chat_json(req)
}

fun serve_json() {
    let app = Server.new()
    app.post("/v1/chat/completions", chat_json)
    app.listen("127.0.0.1:8351")
}

fun serve_sse() {
    let app = Server.new()
    app.post("/v1/chat/completions", chat_sse)
    app.listen("127.0.0.1:8352")
}

fun serve_flaky() {
    let app = Server.new()
    app.post("/v1/chat/completions", chat_flaky)
    app.listen("127.0.0.1:8353")
}

fun serve_sse_8354() {
    let app = Server.new()
    app.post("/v1/chat/completions", chat_sse)
    app.listen("127.0.0.1:8354")
}

fun serve_sse_8355() {
    let app = Server.new()
    app.post("/v1/chat/completions", chat_sse)
    app.listen("127.0.0.1:8355")
}

// The server binds in a goroutine; give it a moment.
fun settle() {
    sleep_millis(150)
}

fun test_complete_against_local_server() {
    spawn {
        serve_json()
    }
    settle()
    let req = ChatRequest.new("custom/local-model").user("ping").key("test").base(
        "http://127.0.0.1:8351/v1",
    )
    match complete(req) {
        case Ok(r) {
            assert_eq_str(r.content, "pong")
            assert_eq_str(r.finish_reason, "stop")
            assert_eq_int(r.usage.total_tokens, 4)
        }
        case Err(e) { assert_eq_str("complete failed", e.message) }
    }
}

fun test_stream_against_local_server() {
    spawn {
        serve_sse()
    }
    settle()
    let req = ChatRequest.new("custom/local-model").user("ping").key("test").base(
        "http://127.0.0.1:8352/v1",
    )
    match complete_stream(req, record) {
        case Ok(r) {
            assert_eq_str(r.content, "Hello")
            assert_eq_str(r.finish_reason, "stop")
            assert_eq_int(sink.len(), 2)
            assert_eq_str(sink[0], "Hel")
            assert_eq_str(sink[1], "lo")
        }
        case Err(e) { assert_eq_str("stream failed", e.message) }
    }
}

fun test_precanceled_stream_stops_before_any_delta() {
    spawn {
        serve_sse_8354()
    }
    settle()
    let tok = CancelToken.new()
    tok.cancel()
    let req = ChatRequest.new("custom/local-model").user("ping").key("test").base(
        "http://127.0.0.1:8354/v1",
    ).cancelable(tok)
    match complete_stream(req, record) {
        case Ok(r) {
            assert_eq_str(r.finish_reason, "canceled")
            assert_eq_str(r.content, "")
            assert_eq_int(sink.len(), 0)
        }
        case Err(e) { assert_eq_str("precanceled stream failed", e.message) }
    }
}

fun test_cancel_mid_stream_keeps_the_partial_reply() {
    spawn {
        serve_sse_8355()
    }
    settle()
    let req = ChatRequest.new("custom/local-model").user("ping").key("test").base(
        "http://127.0.0.1:8355/v1",
    ).cancelable(cancel_tok)
    match complete_stream(req, record_and_cancel) {
        case Ok(r) {
            // The first delta streamed, the callback canceled, and the
            // second delta never arrived.
            assert_eq_str(r.finish_reason, "canceled")
            assert_eq_str(r.content, "Hel")
            assert_eq_int(sink.len(), 1)
            assert_eq_str(sink[0], "Hel")
        }
        case Err(e) { assert_eq_str("mid-stream cancel failed", e.message) }
    }
}

fun test_transient_error_is_retried() {
    spawn {
        serve_flaky()
    }
    settle()
    let req = ChatRequest.new("custom/local-model").user("ping").key("test").base(
        "http://127.0.0.1:8353/v1",
    ).retries(2)
    match complete(req) {
        case Ok(r) {
            assert_eq_str(r.content, "pong")
            assert_true(hits >= 2)
        }
        case Err(e) { assert_eq_str("retry failed", e.message) }
    }
}
