// The accumulated state of one streamed completion, shared by every
// adapter: each applies its provider's events to this and hands back text
// deltas, and the finished accumulator becomes the ChatReply.

from "../message" import ToolCall
from "../request" import ChatReply, Usage

class StreamAcc {
    text: str
    model: str
    finish_reason: str
    tool_calls: list[ToolCall]
    prompt_tokens: int
    completion_tokens: int
    total_tokens: int
    cache_read_tokens: int
    cache_write_tokens: int
}

impl StreamAcc {
    fun new() -> StreamAcc {
        let calls: list[ToolCall] = []
        return StreamAcc(
            text: "",
            model: "",
            finish_reason: "",
            tool_calls: calls,
            prompt_tokens: 0,
            completion_tokens: 0,
            total_tokens: 0,
            cache_read_tokens: 0,
            cache_write_tokens: 0,
        )
    }

    fun to_reply(self) -> ChatReply {
        var total = self.total_tokens
        if total == 0 {
            total = self.prompt_tokens + self.completion_tokens
        }
        return ChatReply(
            content: self.text,
            model: self.model,
            finish_reason: self.finish_reason,
            tool_calls: self.tool_calls,
            usage: Usage(
                prompt_tokens: self.prompt_tokens,
                completion_tokens: self.completion_tokens,
                total_tokens: total,
                cache_read_tokens: self.cache_read_tokens,
                cache_write_tokens: self.cache_write_tokens,
            ),
            raw: "",
        )
    }
}
