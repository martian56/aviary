// Conversation messages and tool definitions. These are provider-neutral;
// each adapter translates them to and from its own wire shape.

from std.json import JsonValue

// Who a message is from. Tool is a tool result being fed back to the model.
enum Role {
    System,
    User,
    Assistant,
    Tool,
}

// The wire name for a role, shared by the OpenAI-style adapters.
fun role_str(r: Role) -> str {
    return match r {
        case System { "system" }
        case User { "user" }
        case Assistant { "assistant" }
        case Tool { "tool" }
    }
}

// A model's request to call a tool. `arguments` is a raw JSON string, as the
// provider returns it, so the caller parses it against the tool's schema.
class ToolCall {
    id: str
    name: str
    arguments: str
}

// One conversation turn. `tool_calls` is set on an assistant turn that
// invokes tools; `tool_call_id` and `name` are set on a Tool turn carrying a
// result back.
class Message {
    role: Role
    content: str
    tool_calls: list[ToolCall]
    tool_call_id: str
    name: str
}

impl Message {
    fun system(text: str) -> Message {
        return _plain(Role.System, text)
    }

    fun user(text: str) -> Message {
        return _plain(Role.User, text)
    }

    fun assistant(text: str) -> Message {
        return _plain(Role.Assistant, text)
    }

    // An assistant turn that requested one or more tool calls.
    fun assistant_calls(text: str, calls: list[ToolCall]) -> Message {
        return Message(
            role: Role.Assistant,
            content: text,
            tool_calls: calls,
            tool_call_id: "",
            name: "",
        )
    }

    // A tool result to feed back, tied to the call it answers.
    fun tool_result(tool_call_id: str, name: str, content: str) -> Message {
        let none: list[ToolCall] = []
        return Message(
            role: Role.Tool,
            content: content,
            tool_calls: none,
            tool_call_id: tool_call_id,
            name: name,
        )
    }
}

fun _plain(role: Role, text: str) -> Message {
    let none: list[ToolCall] = []
    return Message(role: role, content: text, tool_calls: none, tool_call_id: "", name: "")
}

// A tool the model may call. `parameters` is a JSON Schema object describing
// the arguments; build it with jsonutil's Obj or std/json directly.
class ToolDef {
    name: str
    description: str
    parameters: JsonValue
}

impl ToolDef {
    fun new(name: str, description: str, parameters: JsonValue) -> ToolDef {
        return ToolDef(name: name, description: description, parameters: parameters)
    }
}
